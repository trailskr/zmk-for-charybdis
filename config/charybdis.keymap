#include <dt-bindings/zmk/mouse.h>
#include <input/processors/zmk-input-processor-keybind.dtsi>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

&trackball_listener {
    status = "okay";
    device = <&trackball>;
    input-processors = <&zip_keybind_keys>;
};

/ {
    combos { compatible = "zmk,combos"; };

    zip_keybind_keys: zip_keybind_keys {
        compatible = "zmk,input-processor-keybind";
        #input-processor-cells = <0>;
        track_remainders;
        bindings = <&kp RIGHT>, <&kp LEFT>, <&kp DOWN>, <&kp UP>;

        tick = <40>;
        wait-ms = <0>;
        tap-ms = <10>;

        // mode = <1>
        // threshold = <10>
        // max_threshold = <200>
        // max_pending_activations = <10>
    };

    keymap {
        compatible = "zmk,keymap";

        Base {
            bindings = <
&kp GRAVE       &kp N1  &kp N2  &kp N3        &kp N4  &kp N5          &kp N6         &kp N7  &kp N8     &kp N9   &kp N0     &none
&kp TAB         &kp Q   &kp W   &kp E         &kp R   &kp T           &kp Y          &kp U   &kp I      &kp O    &kp P      &kp MINUS
&kp LEFT_SHIFT  &kp A   &kp S   &kp D         &kp F   &kp G           &kp H          &kp J   &kp K      &kp L    &kp SEMI   &kp APOS
&kp LCTRL       &kp Z   &kp X   &kp C         &kp V   &kp B           &kp N          &kp M   &kp COMMA  &kp DOT  &kp SLASH  &kp EQUAL
                                &kp LEFT_ALT  &mo 1   &kp SPACE       &kp ENTER      &mo 2
                                              &mo 3   &kp LEFT_WIN    &kp BACKSPACE
            >;
        };

        Lower {
            bindings = <
&kp ESCAPE    &kp C_BRIGHTNESS_DEC  &kp C_VOLUME_DOWN  &kp C_MUTE      &kp C_VOLUME_UP  &kp C_BRIGHTNESS_INC    &kp KP_NUMLOCK  &kp C_PREVIOUS   &kp C_PLAY       &kp C_NEXT           &kp C_AL_CALCULATOR  &none
&kt CAPSLOCK  &kp INSERT            &kp HOME           &kp UP_ARROW    &kp END          &kp PAGE_UP             &kp KP_EQUAL    &kp KP_NUMBER_7  &kp KP_NUMBER_8  &kp LS(KP_NUMBER_9)  &kp KP_MINUS         &none
&trans        &kp F2                &kp LEFT_ARROW     &kp DOWN_ARROW  &kp RIGHT        &kp PAGE_DOWN           &kp KP_DIVIDE   &kp KP_NUMBER_4  &kp KP_NUMBER_5  &kp KP_NUMBER_6      &kp KP_PLUS          &kp KP_COMMA
&trans        &kp F8                &kp PRINTSCREEN    &kp SCROLLLOCK  &kp PAUSE_BREAK  &kp C_MENU              &kp KP_DOT      &kp KP_NUMBER_1  &kp KP_NUMBER_2  &kp KP_NUMBER_3      &kp KP_EQUAL         &none
                                                       &trans          &trans           &trans                  &trans          &trans
                                                                       &trans           &trans                  &kp DELETE
            >;
        };

        Raise {
            bindings = <
&kp ESCAPE  &none     &none             &none     &none     &none        &none      &none     &none     &none              &none          &none
&kp F1      &kp F2    &kp F3            &kp F4    &kp F5    &kp F6       &kp F7     &kp F8    &kp F9    &kp F10            &kp F11        &kp F12
&trans      &kp EXCL  &kp AT            &kp HASH  &kp DLLR  &kp PRCNT    &kp CARET  &kp AMPS  &kp STAR  &kp PIPE           &kp BACKSLASH  &none
&trans      &kp F     &kp LEFT_BRACKET  &kp LBRC  &kp LPAR  &none        &none      &kp RPAR  &kp RBRC  &kp RIGHT_BRACKET  &none          &none
                                        &trans    &trans    &trans       &trans     &trans
                                                  &trans    &trans       &trans
            >;
        };

        Mouse {
            bindings = <
&none        &none         &none         &none         &none      &none             &none           &none      &none         &none         &none         &none
&none        &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &none      &bt BT_CLR        &bt BT_CLR      &none      &bt BT_SEL 2  &bt BT_SEL 1  &bt BT_SEL 0  &none
&none        &mo 4         &mkp RCLK     &mkp MCLK     &mkp LCLK  &none             &none           &mkp LCLK  &mkp MCLK     &mkp RCLK     &mo 4         &none
&bootloader  &none         &none         &none         &none      &studio_unlock    &studio_unlock  &none      &none         &none         &none         &bootloader
                                         &trans        &trans     &trans            &trans          &trans
                                                       &trans     &trans            &trans
            >;
        };

        Scroll {
            bindings = <
&none   &none  &none   &none   &none   &none     &none   &none   &none   &none   &none  &none
&trans  &none  &none   &none   &none   &none     &none   &none   &none   &none   &none  &none
&trans  &none  &trans  &trans  &trans  &none     &none   &trans  &trans  &trans  &none  &none
&trans  &none  &none   &none   &none   &none     &none   &none   &none   &none   &none  &none
                       &trans  &trans  &trans    &trans  &trans
                               &trans  &trans    &trans
            >;
        };

        Snipe {
            bindings = <
&none   &none  &none   &none   &none   &none     &none   &none   &none   &none   &none  &none
&trans  &none  &none   &none   &none   &none     &none   &none   &none   &none   &none  &none
&trans  &none  &trans  &trans  &trans  &none     &none   &trans  &trans  &trans  &none  &none
&trans  &none  &none   &none   &none   &none     &none   &none   &none   &none   &none  &none
                       &trans  &trans  &trans    &trans  &trans
                               &trans  &trans    &trans
            >;
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";

        Snipe {
            if-layers = <1 3>;
            then-layer = <5>;
        };
    };
};
