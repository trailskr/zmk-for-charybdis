#include <dt-bindings/zmk/mouse.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/ruen.h>
#include <behaviors/ruen.dtsi>

&ruen {
    en-key = <LA(LS(N1))>;
    ru-key = <LA(LS(N2))>;
    default-mode = <1>;
};

&mt {
  tapping-term-ms = <200>;
  quick-tap-ms = <200>;
};

&lt {
  tapping-term-ms = <200>;
  quick-tap-ms = <200>;
  require-prior-idle-ms = <0>;
};

/ {
    combos { compatible = "zmk,combos"; };

    macros {
        console_log_macro: console_log_macro {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings = <&ruen RUEN_EN &kp C &kp O &kp N &kp S &kp O &kp L &kp E &kp DOT &kp L &kp O &kp G>;
            label = "CONSOLE_LOG_MACRO";
        };

        em_dash: em_dash {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings
                = <&macro_press &kp LALT>
                , <&macro_tap &kp KP_N0 &kp KP_N1 &kp KP_N5 &kp KP_N1>
                , <&macro_release &kp LALT>
                ;
            label = "EM_DASH";
        };

        lang_en: lang_en {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings
                = <&macro_press &ruen RUEN_EN>
                , <&macro_pause_for_release>
                , <&macro_release &ruen RUEN_EN>
                ;
            label = "LANG_EN";
        };

        lang_ru: lang_ru {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings
                = <&macro_press &ruen RUEN_RU>
                , <&macro_pause_for_release>
                , <&macro_release &ruen RUEN_RU>
                ;
            label = "LANG_RU";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        // 0
        Base {
//                    //                    //                    //                    //                    // ________||________ //                    //                    //                    //                    //                    //                    //
            bindings = < 
&ruen_yo              &kp N1                &kp N2                &kp N3                &kp N4                &kp N5                &kp N6                &kp N7                &kp N8                &kp N9                &kp N0                &none                 //
&kp TAB               &kp Q                 &kp W                 &kp E                 &kp R                 &kp T                 &kp Y                 &kp U                 &kp I                 &kp O                 &kp P                 &ruen_kha             //
&kp LEFT_SHIFT        &kp A                 &kp S                 &kp D                 &kp F                 &kp G                 &kp H                 &kp J                 &kp K                 &kp L                 &ruen_zhe             &ruen_e               //
&kp LCTRL             &kp Z                 &kp X                 &kp C                 &kp V                 &kp B                 &kp N                 &kp M                 &ruen_be              &ruen_yu              &ruen_hrd_sgn         &none                 //
                                                                  &mo 5                 &mo 1                 &mo 9                 &mt LEFT_WIN DELETE   &lt 2 BACKSPACE       //
                                                                                        &kp LEFT_ALT          &kp SPACE             &kp ENTER             //
            >;
        };

        // 1
        Lower {
//                    //                    //                    //                    //                    // ________||________ //                    //                    //                    //                    //                    //                    //
            bindings = <
&kp ESCAPE            &kp C_BRIGHTNESS_DEC  &kp C_VOLUME_DOWN     &kp C_MUTE            &kp C_VOLUME_UP       &kp C_BRIGHTNESS_INC  &kp KP_NUMLOCK        &kp C_PREVIOUS        &kp C_PLAY            &kp C_NEXT            &kp C_AL_CALCULATOR   &none                 //
&trans                &kp INSERT            &kp HOME              &kp UP                &kp END               &kp PAGE_UP           &kp KP_EQUAL          &kp KP_NUMBER_7       &kp KP_NUMBER_8       &kp KP_NUMBER_9       &kp KP_MINUS          &none                 //
&trans                &none                 &kp LEFT              &kp DOWN              &kp RIGHT             &kp PAGE_DOWN         &kp KP_DIVIDE         &kp KP_NUMBER_4       &kp KP_NUMBER_5       &kp KP_NUMBER_6       &kp KP_PLUS           &kp KP_COMMA          //
&trans                &none                 &kp PRINTSCREEN       &kp SCROLLLOCK        &kp PAUSE_BREAK       &kp C_MENU            &kp KP_DOT            &kp KP_NUMBER_1       &kp KP_NUMBER_2       &kp KP_NUMBER_3       &kp KP_EQUAL          &kp KP_NUMBER_0       //
                                                                  &trans                &trans                &trans                &trans                &mo 3                 //
                                                                                        &trans                &trans                &trans                //
            >;         
        };

        // 2
        // &ruen_store  &ruen_revert
        Raise {
//                    //                    //                    //                    //                    // ________||________ //                    //                    //                    //                    //                    //                    //
            bindings = <
&kp ESCAPE            &none                 &none                 &none                 &none                 &none                 &none                 &none                 &none                 &none                 &none                 &none                 //
&kp F1                &kp F2                &kp F3                &kp F4                &kp F5                &kp F6                &kp F7                &kp F8                &kp F9                &kp F10               &kp F11               &kp F12               //
&trans                &ruen_dot             &ruen_at              &ruen_hash            &ruen_dllr            &ruen_prcnt           &ruen_caret           &ruen_amps            &kp STAR              &ruen_pipe            &ruen_comma           &ruen_sqt             //
&trans                &kp F                 &ruen_tilde           &ruen_lt              &kp LPAR              &none                 &none                 &kp RPAR              &ruen_gt              &none                 &none                 &kp MINUS             //
                                                                  &mo 4                 &mo 3                 &trans                &trans                &trans                //
                                                                                        &trans                &trans                &trans                //
            >;
        };

        // 3
        Raise2 {
//                    //                    //                    //                    //                    // ________||________ //                    //                    //                    //                    //                    //                    //
            bindings = <
&none                 &none                 &none                 &none                 &none                 &none                 &none                 &none                 &none                 &none                 &none                 &none                 //
&trans                &none                 &none                 &none                 &none                 &none                 &none                 &none                 &none                 &none                 &none                 &none                 //
&trans                &kp EXCL              &none                 &ruen_num             &ruen_ruble           &none                 &none                 &none                 &none                 &ruen_fslh            &ruen_semi            &ruen_dqt             //
&trans                &none                 &em_dash              &none                 &ruen_lbrc            &none                 &none                 &ruen_rbrc            &none                 &none                 &none                 &kp EQUAL             //
                                                                  &trans                &trans                &trans                &trans                &trans                //
                                                                                        &trans                &trans                &trans                //
            >;
        };

        // 4
        Raise3 {
//                    //                    //                    //                    //                    // ________||________ //                    //                    //                    //                    //                    //                    //        
            bindings = <
&none                 &none                 &none                 &none                 &none                 &none                 &none                 &none                 &none                 &none                 &none                 &none                 //
&trans                &none                 &none                 &none                 &none                 &none                 &none                 &none                 &none                 &none                 &none                 &none                 //
&trans                &ruen_qmark           &none                 &none                 &none                 &none                 &none                 &none                 &none                 &kp BACKSLASH         &ruen_colon           &ruen_grave           //
&trans                &none                 &none                 &none                 &ruen_lbkt            &none                 &none                 &ruen_rbkt            &none                 &none                 &none                 &kp UNDER             //
                                                                  &trans                &trans                &trans                &trans                &trans                //
                                                                                        &trans                &trans                &trans                //
            >;
        };

        // 5
        Mouse {
//                    //                    //                    //                    //                    // ________||________ //                    //                    //                    //                    //                    //                    //
            bindings = <
&bootloader           &bt BT_SEL 0          &bt BT_SEL 1          &bt BT_SEL 2          &none                 &bt BT_CLR            &bt BT_CLR            &none                 &bt BT_SEL 2          &bt BT_SEL 1          &bt BT_SEL 0          &bootloader           //
&trans                &mo 8                 &mkp RCLK             &mkp MCLK             &mkp LCLK             &none                 &none                 &none                 &none                 &none                 &none                 &none                 //
&trans                &mo 6                 &mkp RCLK             &mkp MCLK             &mkp LCLK             &none                 &none                 &none                 &none                 &none                 &none                 &none                 //
&trans                &mo 7                 &mkp RCLK             &mkp MCLK             &mkp LCLK             &studio_unlock        &studio_unlock        &none                 &none                 &none                 &none                 &kp CAPSLOCK          //
                                                                  &trans                &trans                &trans                &trans                &mo 4                 //
                                                                                        &trans                &trans                &trans                //
            >;
        };

        // 6
        Scroll {
//                    //                    //                    //                    //                    // ________||________ //                    //                    //                    //                    //                    //                    //
            bindings = <
&none                 &none                 &none                 &none                 &none                 &none                 &none                 &none                 &none                 &none                 &none                 &none                 //
&trans                &none                 &trans                &trans                &trans                &none                 &none                 &trans                &trans                &trans                &none                 &none                 //
&trans                &none                 &trans                &trans                &trans                &none                 &none                 &trans                &trans                &trans                &none                 &none                 //
&trans                &none                 &trans                &trans                &trans                &none                 &none                 &trans                &trans                &trans                &none                 &none                 //
                                                                  &trans                &trans                &trans                &trans                &trans                //
                                                                                        &trans                &trans                &trans                //
            >;
        };

        // 7
        Snipe {
//                    //                    //                    //                    //                    // ________||________ //                    //                    //                    //                    //                    //                    //
            bindings = <
&none                 &none                 &none                 &none                 &none                 &none                 &none                 &none                 &none                 &none                 &none                 &none                 //
&trans                &none                 &trans                &trans                &trans                &none                 &none                 &trans                &trans                &trans                &none                 &none                 //
&trans                &none                 &trans                &trans                &trans                &none                 &none                 &trans                &trans                &trans                &none                 &none                 //
&trans                &none                 &trans                &trans                &trans                &none                 &none                 &trans                &trans                &trans                &none                 &none                 //
                                                                  &trans                &trans                &trans                &trans                &trans                //
                                                                                        &trans                &trans                &trans                //
            >;
        };

        // 8
        Arrows {
//                    //                    //                    //                    //                    // ________||________ //                    //                    //                    //                    //                    //                    //
            bindings = <
&none                 &none                 &none                 &none                 &none                 &none                 &none                 &none                 &none                 &none                 &none                 &none                 //
&trans                &none                 &trans                &trans                &trans                &none                 &none                 &trans                &trans                &trans                &none                 &none                 //
&trans                &none                 &trans                &trans                &trans                &none                 &none                 &trans                &trans                &trans                &none                 &none                 //
&trans                &none                 &trans                &trans                &trans                &none                 &none                 &trans                &trans                &trans                &none                 &none                 //
                                                                  &trans                &trans                &trans                &trans                &trans                //
                                                                                        &trans                &trans                &trans                //
            >;
        };

        // 9
        Macros {
//                    //                    //                    //                    //                    // ________||________ //                    //                    //                    //                    //                    //                    //
            bindings = <
&trans                &trans                &trans                &trans                &trans                &trans                &trans                &trans                &trans                &trans                &trans                &trans                //
&trans                &trans                &trans                &lang_en              &lang_ru              &trans                &trans                &trans                &trans                &trans                &trans                &trans                //
&trans                &trans                &trans                &trans                &trans                &trans                &trans                &trans                &trans                &console_log_macro    &trans                &trans                //
&trans                &trans                &trans                &trans                &trans                &trans                &trans                &trans                &trans                &trans                &trans                &trans                //
                                                                  &trans                &trans                &trans                &trans                &trans                //
                                                                                        &trans                &trans                &trans                //
            >;
        };
    };
};
