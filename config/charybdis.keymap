#include <dt-bindings/zmk/mouse.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

&mt {
  tapping-term-ms = <150>;
  quick-tap-ms = <150>;
};

&lt {
  tapping-term-ms = <150>;
  quick-tap-ms = <150>;
  require-prior-idle-ms = <0>;
};

/ {
    combos { compatible = "zmk,combos"; };

    macros {
        console_log_macro: console_log_macro {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp C &kp O &kp N &kp S &kp O &kp L &kp E &kp DOT &kp L &kp O &kp G &kp LPAR &kp RPAR &kp LEFT_ARROW>;
            label = "CONSOLE_LOG_MACRO";
        };

        const_macro: const_macro {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp C &kp O &kp N &kp S &kp T>;
            label = "CONST_MACRO";
        };

        arrow_fn_macro: arrow_fn_macro {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LPAR &kp RPAR &kp SPACE &kp EQUAL &kp GT &kp SPACE>;
            label = "ARROW_FN_MACRO";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        Base {
            bindings = <
&kp GRAVE       &kp N1  &kp N2  &kp N3        &kp N4        &kp N5     &kp N6               &kp N7           &kp N8     &kp N9   &kp N0     &mo 3
&kp TAB         &kp Q   &kp W   &kp E         &kp R         &kp T      &kp Y                &kp U            &kp I      &kp O    &kp P      &kp MINUS
&kp LEFT_SHIFT  &kp A   &kp S   &kp D         &kp F         &kp G      &kp H                &kp J            &kp K      &kp L    &kp SEMI   &kp APOS
&kp LCTRL       &kp Z   &kp X   &kp C         &kp V         &kp B      &kp N                &kp M            &kp COMMA  &kp DOT  &kp SLASH  &kp EQUAL
                                &mo 3         &mo 1         &mo 7      &mt LEFT_WIN DELETE  &lt 2 BACKSPACE
                                              &kp LEFT_ALT  &kp SPACE  &kp ENTER
            >;
        };

        Lower {
            bindings = <
&kp ESCAPE  &kp C_BRIGHTNESS_DEC  &kp C_VOLUME_DOWN  &kp C_MUTE      &kp C_VOLUME_UP  &kp C_BRIGHTNESS_INC    &kp KP_NUMLOCK   &kp C_PREVIOUS   &kp C_PLAY       &kp C_NEXT           &kp C_AL_CALCULATOR  &none
&trans      &kp INSERT            &kp HOME           &kp UP_ARROW    &kp END          &kp PAGE_UP             &kp KP_EQUAL     &kp KP_NUMBER_7  &kp KP_NUMBER_8  &kp KP_NUMBER_9      &kp KP_MINUS         &none
&trans      &kp F2                &kp LEFT_ARROW     &kp DOWN_ARROW  &kp RIGHT        &kp PAGE_DOWN           &kp KP_DIVIDE    &kp KP_NUMBER_4  &kp KP_NUMBER_5  &kp KP_NUMBER_6      &kp KP_PLUS          &kp KP_COMMA
&trans      &kp F8                &kp PRINTSCREEN    &kp SCROLLLOCK  &kp PAUSE_BREAK  &kp C_MENU              &kp KP_DOT       &kp KP_NUMBER_1  &kp KP_NUMBER_2  &kp KP_NUMBER_3      &kp KP_EQUAL         &none
                                                     &trans          &trans           &trans                  &trans           &kp KP_NUMBER_0  
                                                                     &trans           &trans                  &trans
            >;
        };

        Raise {
            bindings = <
&kp ESCAPE  &none     &none             &none     &none     &none        &none         &none     &none     &none              &none          &bootloader
&kp F1      &kp F2    &kp F3            &kp F4    &kp F5    &kp F6       &kp F7        &kp F8    &kp F9    &kp F10            &kp F11        &kp F12
&trans      &kp EXCL  &kp AT            &kp HASH  &kp DLLR  &kp PRCNT    &kp CARET     &kp AMPS  &kp STAR  &kp PIPE           &kp BACKSLASH  &none
&trans      &kp F     &kp LEFT_BRACKET  &kp LBRC  &kp LPAR  &none        &kp LEFT_WIN  &kp RPAR  &kp RBRC  &kp RIGHT_BRACKET  &none          &kp CAPSLOCK
                                        &trans    &trans    &trans       &trans        &trans
                                                  &trans    &trans       &trans
            >;
        };

        Mouse {
            bindings = <
&bootloader  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &none      &bt BT_CLR        &bt BT_CLR      &none      &bt BT_SEL 2  &bt BT_SEL 1  &bt BT_SEL 0  &bootloader
&trans       &mo 6         &mkp RCLK     &mkp MCLK     &mkp LCLK  &none             &none           &mkp LCLK  &mkp MCLK     &mkp RCLK     &none         &none
&trans       &mo 4         &mkp RCLK     &mkp MCLK     &mkp LCLK  &none             &none           &mkp LCLK  &mkp MCLK     &mkp RCLK     &mo 4         &none
&trans       &mo 5         &mkp RCLK     &mkp MCLK     &mkp LCLK  &studio_unlock    &studio_unlock  &mkp LCLK  &mkp MCLK     &mkp RCLK     &mo 6         &bootloader
                                         &trans        &trans     &trans            &trans          &trans
                                                       &trans     &trans            &trans
            >;
        };

        Scroll {
            bindings = <
&none   &none  &none   &none   &none   &none     &none   &none   &none   &none   &none  &none
&trans  &none  &trans  &trans  &trans  &none     &none   &trans  &trans  &trans  &none  &none
&trans  &none  &trans  &trans  &trans  &none     &none   &trans  &trans  &trans  &none  &none
&trans  &none  &trans  &trans  &trans  &none     &none   &trans  &trans  &trans  &none  &none
                       &trans  &trans  &trans    &trans  &trans
                               &trans  &trans    &trans
            >;
        };

        Snipe {
            bindings = <
&none   &none  &none   &none   &none   &none     &none   &none   &none   &none   &none  &none
&trans  &none  &trans  &trans  &trans  &none     &none   &trans  &trans  &trans  &none  &none
&trans  &none  &trans  &trans  &trans  &none     &none   &trans  &trans  &trans  &none  &none
&trans  &none  &trans  &trans  &trans  &none     &none   &trans  &trans  &trans  &none  &none
                       &trans  &trans  &trans    &trans  &trans
                               &trans  &trans    &trans
            >;
        };

        Arrows {
            bindings = <
&none   &none  &none   &none   &none   &none     &none   &none   &none   &none   &none  &none
&trans  &none  &trans  &trans  &trans  &none     &none   &trans  &trans  &trans  &none  &none
&trans  &none  &trans  &trans  &trans  &none     &none   &trans  &trans  &trans  &none  &none
&trans  &none  &trans  &trans  &trans  &none     &none   &trans  &trans  &trans  &none  &none
                       &trans  &trans  &trans    &trans  &trans
                               &trans  &trans    &trans
            >;
        };

        Macros {
            bindings = <
&trans  &trans  &trans  &trans        &trans  &trans    &trans  &trans  &trans  &trans              &trans  &none
&trans  &trans  &trans  &trans        &trans  &trans    &trans  &trans  &trans  &trans              &trans  &none
&trans  &trans  &trans  &trans        &trans  &trans    &trans  &trans  &trans  &console_log_macro  &trans  &none
&trans  &trans  &trans  &const_macro  &trans  &trans    &trans  &trans  &trans  &trans              &trans  &arrow_fn_macro
                        &trans        &trans  &trans    &trans  &trans
                                      &trans  &trans    &trans
            >;
        };
    };
};
